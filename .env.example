RUST_LOG=info
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=postgresql://localhost/rust_learning
EXECUTOR_BASE_URL=http://localhost:8082
EXECUTOR_HOST=0.0.0.0
EXECUTOR_PORT=8082
EXECUTOR_TIMEOUT_SECS=8
EXECUTOR_OUTPUT_LIMIT_BYTES=20000
EXECUTOR_WORKDIR_ROOT=/tmp/rust-learning-executor
JWT_ISSUER=http://localhost:8081/realms/rust-learning
JWT_AUDIENCE=rust-learning-web
JWT_JWKS_URL=http://localhost:8081/realms/rust-learning/protocol/openid-connect/certs
# Optional local HS256 test mode for API auth tests
JWT_HS256_SECRET=
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/rust-learning
VITE_OIDC_CLIENT_ID=rust-learning-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173
