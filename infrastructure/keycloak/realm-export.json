{
  "realm": "nextechincubator",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "LEARNER" },
      { "name": "AUTHOR" },
      { "name": "ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "rust-learning-web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://rust.NEXTECHINCUBATOR.COM/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "https://rust.NEXTECHINCUBATOR.COM",
        "http://localhost:5173",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "rust-learning-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rust-learning-web",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "learner",
      "firstName": "Learner",
      "lastName": "User",
      "email": "learner@example.test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "learner", "temporary": false }],
      "realmRoles": ["LEARNER"]
    }
  ]
}
